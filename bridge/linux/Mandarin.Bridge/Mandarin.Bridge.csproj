<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mandarin Bridge for Linux (item 282): a computer with a USB DAC (a Raspberry Pi, say) as a UPnP renderer that
    Mandarin plays to, bit-perfect, through Mandarin's own audio engine. Built ahead of time to one native program
    (Native AOT), so it needs no .NET where it runs. See bridge/linux/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mandarin-bridge</AssemblyName>
    <RootNamespace>Mandarin.Bridge</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>

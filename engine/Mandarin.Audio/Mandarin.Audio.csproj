<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mandarin's audio engine (v0.8.0): plays to a sound device on the server's
    own computer. Built ahead of time to one native program (Native AOT), so
    it needs no .NET installed where it runs. See engine/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>mandarin-audio</AssemblyName>
    <RootNamespace>Mandarin.Audio</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- One small heap, collected without a background thread: the playback
         thread allocates nothing, so the collector rarely has work to do. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- No packages to audit; and an audit that can't reach NuGet must not fail the build. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>

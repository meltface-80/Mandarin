{
  "name": "musicd-server",
  "version": "0.9.2",
  "description": "A music server for your local files that plays to Sonos rooms and UPnP/DLNA renderers (WiiM, Chord Poly). MusicD Remote's interface; hi-res to 24/48 for Sonos, bit-perfect or upsampled for renderers.",
  "license": "MIT",
  "author": "Lewis Menzies (Music Duck / MusicD)",
  "homepage": "https://github.com/meltface-80/Mandarin",
  "repository": {
    "type": "git",
    "url": "https://github.com/meltface-80/Mandarin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --require ./test/setup.js --test --test-concurrency=4 --test-timeout=300000 --test-force-exit test/*.test.js",
    "test:shard": "node --require ./test/setup.js --test --test-concurrency=${TEST_CONCURRENCY:-4} --test-timeout=300000 --test-force-exit --test-shard=${TEST_SHARD:-1/1} test/*.test.js",
    "tools": "npm ci --prefix tools/lint --no-audit --no-fund",
    "lines": "node tools/quality/file-length.js",
    "lint": "tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.js --suppressions-location tools/lint/eslint-suppressions.json .",
    "lint:prune": "tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.js --suppressions-location tools/lint/eslint-suppressions.json --prune-suppressions .",
    "typecheck": "node tools/quality/tscheck.js && tools/lint/node_modules/.bin/tsc -p tools/lint/tsconfig.json",
    "gates": "npm run lines && npm run typecheck && npm run lint",
    "check": "npm run gates && npm test"
  },
  "devDependencies": {
    "better-sqlite3": "^11.7.0",
    "fast-xml-parser": "^5.11.1",
    "music-metadata": "^11.13.0",
    "sharp": "^0.35.5"
  }
}

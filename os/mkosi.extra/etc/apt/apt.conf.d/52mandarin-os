// Mandarin OS (item 389): Debian's security updates alone, applied by the weekly upkeep (/usr/lib/mandarin-os/maintain)
// when nothing plays, never by apt's own timers at any hour. What nothing needs any more is removed; the computer is
// started again by the upkeep, only when an update needs it and nothing plays.
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::MinimalSteps "true";
DPkg::Options { "--force-confdef"; "--force-confold"; };

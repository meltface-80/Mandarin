[Unit]
Description=Mandarin OS: the system page, http://mandarin/
After=network.target mandarin-os-apply.service
# Installed only (the USB stick is the installer).
ConditionPathIsMountPoint=/data

[Service]
# Its own errors in the share, beside Mandarin OS's log (MandarinOS/Logs/SystemPage_errors.txt).
ExecStart=/bin/sh -c 'mkdir -p /data/MandarinOS/Logs && exec /usr/bin/python3 /usr/lib/mandarin-os/system-page/server.py 2>>/data/MandarinOS/Logs/SystemPage_errors.txt'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

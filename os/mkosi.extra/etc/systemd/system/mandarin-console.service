[Unit]
Description=Mandarin OS: the screen (where to find Mandarin; networkreset), or the installer from the USB stick
After=systemd-user-sessions.service mandarin-os-apply.service network-online.target
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/lib/mandarin-os/console
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1
Environment=TERM=linux

[Install]
WantedBy=multi-user.target

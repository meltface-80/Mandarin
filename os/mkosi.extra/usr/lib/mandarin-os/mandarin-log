#!/usr/bin/python3
"""/usr/lib/mandarin-os/mandarin-log — Mandarin's one log on Mandarin OS (item 425), its only writer (mandarin-log.service).

Every part of Mandarin on the box says its lines to the journal: Mandarin's server on its standard output (with the
Android app's, the page's and every other Bridge's, which reach the server), Mandarin Bridge on its standard error, the
OS's scripts through logger (log.sh's oslog), the system page and every other mandarin-os unit on theirs, and systemd of
each of them. This follows the journal and writes each of those lines, a line an event in the order they came, into one
plain-text file on the shared folder, smb://<box>/Data/Logs (read-only there):

  2026-11-15 09:43:12.345 UTC  INFO   [server] [scan] 12 albums added
  2026-11-15 09:43:13.002 UTC  INFO   [os] [usb] mounted /data/Storage/USB/Music SSD (exfat)
  2026-11-15 09:43:14.120 UTC  WARN   [bridge Mandarin Bridge (mandarin)] [player] the DAC went away
  2026-11-15 09:43:15.871 UTC  INFO   [app Pixel 8] [NET] server GET /api/zones → ok in 40 ms

/data/Logs/Mandarin_log.txt is the newest; at 8 MB it becomes Mandarin_log.01.txt (the one before .02, and so on) and
a new one is begun, ten files in all, the oldest let go; a roll comes between two lines, never in one. Where the journal
was read to is kept (/data/MandarinOS/log-cursor), so a restart, an update or a power cut takes no line twice and loses
none the journal still has; stopped, it reads the journal to its end first. Each line is scrubbed as Mandarin's server
scrubs its own (LogScrub.cs): no keys, tokens, passwords, email addresses, internet or Tailscale addresses, home folders.
The per-component logs from before (MandarinOS/Logs, MandarinServer/Logs) are let go once it is running.

  mandarin-log            follow the journal (the service)
  mandarin-log --stdin    the journal's JSON entries read from standard input instead, to its end (the tests')
"""
import datetime
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

ROOT = os.environ.get("MANDARIN_OS_ROOT", "")
LOGS = ROOT + "/data/Logs"
NAME = "Mandarin_log"
FILES = 10
MOST = int(os.environ.get("MANDARIN_LOG_BYTES") or 8 * 1024 * 1024)
CURSOR = ROOT + "/data/MandarinOS/log-cursor"
OLD = [ROOT + "/data/MandarinOS/Logs", ROOT + "/data/MandarinServer/Logs"]
LEVELS = ("INFO", "WARN", "ERROR", "DEBUG")

# ---------------------------------------------------------------------------------------------------- what is kept

HIDDEN = "[…]"
_URL_LOGIN = re.compile(r"(://)[^/\s:@]+:[^/\s@]+@")
_TS_LOGIN = re.compile(r"(login\.tailscale\.com/a/)[^\s\"']+")
_BEARER = re.compile(r"\b(Bearer|Basic)\s+[^\s&,;]+")
_SECRET = re.compile(r"(?i)\b([\w-]*(?:token|password|passwd|pwd|secret|apikey|api[_-]key|sig|signature|authorization|cookie))(\s*[=:]\s*)(?!\[…\])[^\s&,;]+")
_EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
_LONG = re.compile(r"\b[A-Za-z0-9_-]{32,}\b")
_UUID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
_V4 = re.compile(r"(?<![\w.])(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?(?![\w.])")
_V6 = re.compile(r"(?<![\w:])(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,6})?::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,6})?)(?:%[\w.-]+)?(?![\w:.])")
_TAILNET = re.compile(r"\b[\w-]+(?:\.[\w-]+)*\.ts\.net\b")
_HOME = re.compile(r"(?<![\w.])(/home/|/Users/|[A-Za-z]:\\Users\\)[^/\\\s]+")


def _v4(s):
    o = [int(x) for x in s.split("/")[0].split(".")]
    if any(x > 255 for x in o):
        return None
    a, b = o[0], o[1]
    if a in (0, 10, 127) or a >= 224 or (a == 169 and b == 254) or (a == 172 and 16 <= b <= 31) or (a == 192 and b == 168) or (a == 192 and b == 0 and o[2] == 0):
        return None
    return "[tailscale]" if a == 100 and 64 <= b <= 127 else "[wan]"


def _v6(s):
    t = s.lower()
    if t.startswith("fd7a:115c:a1e0:"):
        return "[tailscale]"
    head = t.split(":")[0]
    if not head:
        return None
    return "[wan]" if 0x2000 <= int(head, 16) <= 0x3fff else None


def scrub(s):
    """[s] without what is the owner's alone: Mandarin's server's LogScrub.cs, rule for rule (item 235)."""
    t = _URL_LOGIN.sub(lambda m: m.group(1) + HIDDEN + "@", s)
    t = _TS_LOGIN.sub(lambda m: m.group(1) + HIDDEN, t)
    t = _BEARER.sub(lambda m: m.group(1) + " " + HIDDEN, t)
    t = _SECRET.sub(lambda m: m.group(1) + m.group(2) + HIDDEN, t)
    t = _EMAIL.sub("[email]", t)
    t = _LONG.sub(lambda m: m.group(0) if _UUID.fullmatch(m.group(0)) else HIDDEN, t)
    t = _V4.sub(lambda m: _v4(m.group(0)) or m.group(0), t)
    t = _V6.sub(lambda m: _v6(m.group(0)) or m.group(0), t)
    t = _TAILNET.sub("[tailscale]", t)
    return _HOME.sub(lambda m: m.group(1) + "[user]", t)

# ---------------------------------------------------------------------------------------------------- whose a line is

# A line as Mandarin writes it: "2026-11-15 09:43:12.345 UTC  INFO   [server] text" (or without where it came from,
# as a server or Bridge from before 425 says it).
_STAMPED = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d{3}) UTC  (INFO|WARN|ERROR|DEBUG)\s+(.*)$")
_SOURCED = re.compile(r"^\[(server|(?:app|web) [^\]]+|bridge(?: [^\]]+)?)\] (.*)$")
_OS_UNIT = re.compile(r"^(mandarin-os[\w@.-]*|mandarin-usb@[\w\\.-]*|mandarin-console|mandarin-log)\.service$")


def owner(e):
    """Whose entry [e] is: "server", "bridge" or "os" (and a word for what said it), or None for one that isn't
    Mandarin's (the kernel's, the network's, a login's)."""
    unit = e.get("_SYSTEMD_UNIT") or ""
    ident = e.get("SYSLOG_IDENTIFIER") or ""
    if ident == "mandarin-os":
        return "os", ""
    if e.get("_PID") == "1":
        about = e.get("UNIT") or e.get("USER_UNIT") or ""
        return ("os", "[systemd] ") if about.startswith("mandarin") or about in ("smbd.service", "data.mount") else None
    if unit == "mandarin.service":
        return "server", ""
    if unit == "mandarin-bridge.service":
        return "bridge", ""
    if unit == "smbd.service":
        return "os", "[samba] "
    if _OS_UNIT.match(unit):
        return "os", "[" + re.sub(r"^mandarin-(os-)?", "", unit[:-len(".service")].split("@")[0]) + "] "
    if e.get("_TRANSPORT") == "kernel":
        msg = text_of(e)
        if priority(e) <= 3 or "mandarin" in msg.lower():
            return "os", "[kernel] "
    return None


def text_of(e):
    m = e.get("MESSAGE")
    if isinstance(m, list):   # bytes that aren't UTF-8, as journalctl's JSON gives them
        return bytes(x for x in m if isinstance(x, int) and 0 <= x < 256).decode("utf-8", "replace")
    return m if isinstance(m, str) else ""


def priority(e):
    try:
        return int(e.get("PRIORITY", 6))
    except (TypeError, ValueError):
        return 6


def stamp(us):
    t = datetime.datetime.fromtimestamp(us / 1e6, datetime.timezone.utc)
    return t.strftime("%Y-%m-%d %H:%M:%S.") + "%03d" % (t.microsecond // 1000)


def lines_of(e):
    """The log's lines for journal entry [e]: none for an entry that isn't Mandarin's, or one a server takes from the
    Bridge itself (a Bridge from before 425 says its lines without where they came from, and Mandarin's server fetches
    them over the network)."""
    who = owner(e)
    if who is None:
        return []
    source, what = who
    try:
        at = stamp(int(e.get("__REALTIME_TIMESTAMP")))
    except (TypeError, ValueError):
        at = stamp(time.time() * 1e6)
    p = priority(e)
    level = "ERROR" if p <= 3 else "WARN" if p == 4 else "INFO"
    out = []
    for raw in text_of(e).split("\n"):
        line = raw.rstrip("\r")
        if not line.strip():
            continue
        m = _STAMPED.match(line) if source in ("server", "bridge") else None
        if m:
            s = _SOURCED.match(m.group(3))
            if s and (source == "server" or s.group(1).startswith("bridge")):
                out.append(f"{m.group(1)} UTC  {m.group(2):<5}  [{s.group(1)}] {scrub(s.group(2))}\n")
            elif source == "server":
                out.append(f"{m.group(1)} UTC  {m.group(2):<5}  [server] {scrub(m.group(3))}\n")
            continue
        lv, text = level, line
        if source == "os" and not what:
            first, _, rest = line.partition(" ")
            if first in LEVELS:
                lv, text = first, rest
        out.append(f"{at} UTC  {lv:<5}  [{source}] {what}{scrub(text)}\n")
    return out

# ---------------------------------------------------------------------------------------------------- the files


class Log:
    """The one log's files, Mandarin_log.txt the newest: whole lines added, a roll between two of them."""

    def __init__(self):
        os.makedirs(LOGS, exist_ok=True)
        self.f = None

    def at(self, n):
        return os.path.join(LOGS, NAME + (".txt" if n == 0 else ".%02d.txt" % n))

    def open(self):
        self.f = open(self.at(0), "ab")

    def roll(self):
        self.f.close()
        self.f = None
        try:
            os.remove(self.at(FILES - 1))
        except FileNotFoundError:
            pass
        for n in range(FILES - 2, -1, -1):
            if os.path.exists(self.at(n)):
                os.replace(self.at(n), self.at(n + 1))
        self.open()

    def add(self, lines):
        for line in lines:
            b = line.encode("utf-8", "replace")
            if self.f is None:
                self.open()
            size = self.f.tell()
            if size > 0 and size + len(b) > MOST:
                self.roll()
            self.f.write(b)
        if lines:
            self.f.flush()


def cursor():
    try:
        with open(CURSOR) as f:
            return f.read().strip() or None
    except OSError:
        return None


def keep_cursor(c):
    if not c:
        return
    try:
        with open(CURSOR + ".new", "w") as f:
            f.write(c + "\n")
        os.replace(CURSOR + ".new", CURSOR)
    except OSError:
        pass


def retire(log):
    """The logs from before the one log let go, said once."""
    gone = [p for p in OLD if os.path.isdir(p)]
    for p in gone:
        shutil.rmtree(p, ignore_errors=True)
    if gone:
        now = stamp(time.time() * 1e6)
        log.add([f"{now} UTC  INFO   [os] [log] the logs from before let go: {', '.join(os.path.relpath(p, ROOT + '/data') for p in gone)}\n"])


def read(stream, log, last):
    """Each entry of [stream] (journalctl's JSON, a line each) into the log; where it was read to."""
    n = 0
    for raw in stream:
        try:
            e = json.loads(raw)
        except ValueError:
            continue
        log.add(lines_of(e))
        last = e.get("__CURSOR") or last
        n += 1
        if n % 200 == 0:
            keep_cursor(last)
    keep_cursor(last)
    return last


def main():
    os.umask(0o027)
    log = Log()
    if "--stdin" in sys.argv[1:]:
        read(sys.stdin, log, None)
        return 0
    try:
        with open(ROOT + "/usr/lib/mandarin-os/VERSION") as f:
            version = f.read().strip()
    except OSError:
        version = "?"
    log.add([f"{stamp(time.time() * 1e6)} UTC  INFO   [os] [log] Mandarin OS {version}: the one log written from here\n"])
    retire(log)
    last = cursor()
    stopping = []
    follow = [None]

    def stop(*_):
        stopping.append(True)
        if follow[0] is not None:
            follow[0].terminate()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while not stopping:
        where = ["--after-cursor", last] if last else ["--boot"]
        follow[0] = subprocess.Popen(["journalctl", "--follow", "--output=json", "--no-pager", "--all"] + where,
                                     stdout=subprocess.PIPE, text=True, encoding="utf-8", errors="replace")
        was = last
        last = read(follow[0].stdout, log, last)
        follow[0].wait()
        if not stopping:
            # journalctl went (journald restarted): followed again from where it was read to. One that refused where it
            # was read to, and gave nothing, is followed from this start of the box instead, rather than never again.
            if follow[0].returncode not in (0, None, -signal.SIGTERM) and last == was:
                last = None
            time.sleep(2)
    # Stopped (the box shutting down): what the journal has after where it was read to, read to its end, so the lines
    # said as Mandarin stopped are in the log.
    if last:
        end = subprocess.Popen(["journalctl", "--output=json", "--no-pager", "--all", "--after-cursor", last],
                               stdout=subprocess.PIPE, text=True, encoding="utf-8", errors="replace")
        read(end.stdout, log, last)
        end.wait()
    return 0


if __name__ == "__main__":
    sys.exit(main())

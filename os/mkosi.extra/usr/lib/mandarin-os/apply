#!/bin/bash
# /usr/lib/mandarin-os/apply — at every start (mandarin-os-apply.service, before Mandarin, the share and the network
# are up): what the installer chose, put in place, and the share's layout made again (item 389). Idempotent.
#
# /data/MachineSettings/setup.json, written by mandarin-os-install:
#   { "share_user": "music", "share_password": "…" (once: taken out as soon as it is set),
#     "network": { "mode": "dhcp" | "static", "address": "192.168.1.20/24", "gateway": "192.168.1.1", "dns": "192.168.1.1" },
#     "bridge": true|false }
set -uo pipefail
. /usr/lib/mandarin-os/log.sh
mountpoint -q /data || { oslog INFO "[apply] no data partition (the USB stick): nothing to apply"; exit 0; }
S=/data/MachineSettings
SETUP="$S/setup.json"
mkdir -p "$S" /data/MandarinOS /data/MandarinServer /data/Storage/USB /data/Share
cp /usr/lib/mandarin-os/VERSION /data/MandarinOS/version.txt 2>/dev/null

# The share's user: the name chosen, a user of the system with no login, in the share's group and Mandarin's. Its
# number is the same in every version of Mandarin OS (item 401: an update starts a new system, where it is made again,
# and the files it owns in Storage and on USB drives must stay its own): 3501, or the number kept in share-uid where
# one is; never the next free one, which a new version's own users could have taken. Mandarin's is 3500
# (mkosi.postinst.chroot), the share's group 3502.
getent group mandarin-share >/dev/null || groupadd --system --gid 3502 mandarin-share
getent group mandarin >/dev/null || groupadd --system --gid 3500 mandarin
# Mandarin Bridge's user, 3503 (item 415, mkosi.postinst.chroot), which its service runs as.
getent group mandarin-bridge >/dev/null || groupadd --system --gid 3503 mandarin-bridge
id mandarin-bridge >/dev/null 2>&1 \
  || useradd --system --uid 3503 --gid mandarin-bridge --no-create-home --home-dir /var/lib/mandarin-bridge --shell /usr/sbin/nologin mandarin-bridge
# Its data folder its own before it starts (mandarin-bridge.service.d waits for this): one a DynamicUser had (a Bridge
# installed before 0.3.12, carried from version to version) is nobody's, which systemd 257 mounts ID-mapped and noexec
# even with DynamicUser off, and the Bridge's update couldn't run from it (item 415). In /var/lib/private until systemd
# moves it back as the Bridge starts.
for d in /var/lib/private/mandarin-bridge /var/lib/mandarin-bridge; do
  if [ -d "$d" ] && [ ! -L "$d" ] && [ "$(stat -c %U:%G "$d")" != mandarin-bridge:mandarin-bridge ]; then
    chown -R mandarin-bridge:mandarin-bridge "$d" && oslog INFO "[apply] Mandarin Bridge's data folder ($d) made its own"
  fi
done
user="$(jq -r '.share_user // empty' "$SETUP" 2>/dev/null)"
if [ -n "$user" ]; then
  uid="$(cat "$S/share-uid" 2>/dev/null || echo 3501)"
  # Said by its number, never its name, the owner's own (item 429: useradd's "<name>'s uid 3501 is greater than
  # SYS_UID_MAX" went into the log); what useradd and usermod say, the name taken out.
  if ! id "$user" >/dev/null 2>&1; then
    if said="$(useradd --system --uid "$uid" --gid mandarin --no-create-home --home-dir /data/Share --shell /usr/sbin/nologin "$user" 2>&1)"; then
      oslog INFO "[apply] the share's user made (uid $uid)"
    else
      oslog ERROR "[apply] the share's user (uid $uid) couldn't be made: ${said//$user/[user]}"
    fi
  fi
  said="$(usermod -a -G mandarin-share,mandarin "$user" 2>&1)" || oslog ERROR "[apply] the share's user couldn't join its groups: ${said//$user/[user]}"
  printf '%s\n' "$user" > "$S/share-user"
  [ -f "$S/share-uid" ] || id -u "$user" > "$S/share-uid"
  pass="$(jq -r '.share_password // empty' "$SETUP")"
  if [ -n "$pass" ]; then
    if printf '%s\n%s\n' "$pass" "$pass" | smbpasswd -s -a "$user" >/dev/null; then
      jq 'del(.share_password)' "$SETUP" > "$SETUP.new" && mv -f "$SETUP.new" "$SETUP"
      oslog INFO "[apply] the share's user set up"
    else
      oslog ERROR "[apply] the share's password couldn't be set"
    fi
  fi
  chmod 600 "$SETUP"
fi

# The network as chosen (once: NetworkManager keeps it after).
if [ "$(jq -r '.network.mode // "dhcp"' "$SETUP" 2>/dev/null)" = static ] && [ ! -f "$S/.network-applied" ]; then
  /usr/lib/mandarin-os/network static "$(jq -r .network.address "$SETUP")" "$(jq -r .network.gateway "$SETUP")" "$(jq -r '.network.dns // empty' "$SETUP")" \
    && touch "$S/.network-applied"
fi

# The share's layout: Storage written, the rest read through links.
cd /data/Share
mkdir -p MandarinServer MandarinOS
# Mandarin's one log (item 425), Logs: written by mandarin-log.service alone, read by the share's group. The logs before
# it, a folder each (MandarinServer/Logs, MandarinBridge, MandarinApp, MandarinOS/Logs), gone from the share; the files
# behind them go once the one log is running (mandarin-log).
install -d -o root -g mandarin-share -m 2750 /data/Logs
chgrp -R mandarin-share /data/Logs; chmod -R g+rX-w,o-rwx /data/Logs
rm -f MandarinServer/Logs MandarinOS/Logs MandarinBridge/Logs MandarinApp/Logs; rmdir MandarinBridge MandarinApp 2>/dev/null
ln -sfn /data/Logs Logs
# Storage is /data/Storage itself (Mandarin's music folder): what is copied in is written there. 0.1.0's first builds
# made it a folder of links; that folder goes.
if [ -d Storage ] && [ ! -L Storage ]; then rm -f Storage/USB Storage/Internal; rmdir Storage; fi
ln -sfn /data/Storage Storage
ln -sfn /data/MandarinServer/backups MandarinServer/Backups
ln -sfn /data/MandarinOS/version.txt MandarinOS/version.txt
ln -sfn /data/MachineSettings/network.txt MachineSettings.txt 2>/dev/null
cat > README.txt <<'TXT'
Mandarin OS — smb://mandarin/data

Storage            Copy your music here: USB holds each USB drive plugged in, Internal the computer's own storage drive.
Logs               Mandarin's log, one file of everything: Mandarin, Mandarin OS, every Mandarin Bridge and the app, a
                   line each in time order (Mandarin_log.txt the newest, then .01 to .09 older; read only).
MandarinServer     Mandarin's backups (read only).
MandarinOS         This system's version (read only).
Installer          Used by Mandarin's reinstaller.

The system page: http://mandarin/   Mandarin: http://mandarin:3500/
TXT
# Readable by the share's group, written only where music goes.
chown root:mandarin-share /data/Share /data/Share/* 2>/dev/null; chmod 0755 /data/Share
chown "${user:-root}:mandarin" /data/Storage /data/Storage/USB; chmod 2775 /data/Storage /data/Storage/USB
# The internal storage drive, where there is one, the same (item 429: a new ext4's top is root's, and the shared folder
# could write nothing in it); its files as they are.
# Storage/Internal's drive known by a label it can have (item 429): an ext4 label is 16 bytes at most, so one formatted
# as "mandarin-internal" (the installer's and the system page's before 0.1.11) was cut to "mandarin-interna" and never
# found by its fstab line. Relabelled in place (nothing on it touched), the line mended, and mounted.
for old in mandarin-interna mandarin-internal; do
  dev="$(blkid -L "$old" 2>/dev/null)" || continue
  if said="$(e2label "$dev" mandarin-store 2>&1)"; then oslog INFO "[apply] internal storage $dev relabelled mandarin-store (was $old)"
  else oslog ERROR "[apply] internal storage $dev couldn't be relabelled: $said"; fi
  udevadm trigger --action=change "$dev" 2>/dev/null; udevadm settle 2>/dev/null
done
if grep -qE '^LABEL=mandarin-internal?[[:space:]]' /etc/fstab; then
  sed -i -E 's/^LABEL=mandarin-internal?[[:space:]]+/LABEL=mandarin-store     /' /etc/fstab
  systemctl daemon-reload; oslog INFO "[apply] internal storage's line in fstab by its new label"
fi
if grep -qE '^LABEL=mandarin-store[[:space:]]' /etc/fstab && ! mountpoint -q /data/Storage/Internal && [ -e /dev/disk/by-label/mandarin-store ]; then
  mkdir -p /data/Storage/Internal
  if systemctl start data-Storage-Internal.mount 2>/dev/null && mountpoint -q /data/Storage/Internal; then oslog INFO "[apply] internal storage mounted at /data/Storage/Internal"
  else oslog ERROR "[apply] internal storage couldn't be mounted at /data/Storage/Internal"; fi
fi
if mountpoint -q /data/Storage/Internal; then
  chown "${user:-root}:mandarin" /data/Storage/Internal; chmod 2775 /data/Storage/Internal
fi
# Installer, which Reinstall Mandarin reads (channel.sh, items 405 and 406), made as Storage is, beside it.
. /usr/lib/mandarin-os/channel.sh && channel_folder "${user:-}"
id mandarin >/dev/null 2>&1 && chown -R mandarin:mandarin /data/MandarinServer && chmod 0750 /data/MandarinServer
mkdir -p /data/MandarinServer/backups && chown mandarin:mandarin /data/MandarinServer/backups
chmod 0750 /data/MandarinServer/backups
# The share's user reads Mandarin's backups through its group (mandarin), and never writes them.
chown -R root:mandarin-share /data/MandarinOS; chmod -R g+rX,o-rwx /data/MandarinOS
ip -4 -o addr show scope global | awk '{ print $2": "$4 }' > /data/MachineSettings/network.txt 2>/dev/null

# Mandarin Bridge beside it, where chosen (a DAC on this computer plays through Mandarin's own engine without it).
if [ "$(jq -r '.bridge // false' "$SETUP" 2>/dev/null)" = true ] && [ ! -x /usr/lib/mandarin-bridge/mandarin-bridge ]; then
  oslog INFO "[apply] Mandarin Bridge chosen: installed once the network is up (mandarin-os-bridge.service)"
  systemctl --no-block start mandarin-os-bridge.service 2>/dev/null || true
fi
oslog INFO "[apply] done"

<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Mandarin's server, in C# (v0.8.1 on; the whole server since v0.9.0, no
    Node server behind it). See server/README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>mandarin-server</AssemblyName>
    <RootNamespace>Mandarin.Server</RootNamespace>
    <!-- ICU's collation, as JavaScript's localeCompare (Library.cs): libicu where it runs. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The analyzer rules in .editorconfig, checked on every build (v0.9.2, audit Q3):
         unused usings are only seen with the documentation file made, which isn't shipped. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A package with a known advisory fails the build (v0.9.0, audit S4). -->
    <NuGetAudit>true</NuGetAudit>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <!-- SQLite's native library inside the one file, unpacked on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
